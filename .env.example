# Copier ce fichier en .env puis remplir les valeurs :
#   cp .env.example .env
# Le fichier .env est ignoré par Git (voir .gitignore).

# --- Stockage S3 ---
# Sur Hyperfluid, chaque clé S3 est limitée à UN bucket :
# Buckets > <nom du bucket> > Access > New key
# La console donne 4 variables AWS_... : colle-les dans le bloc du bon bucket,
# en ajoutant le préfixe (SOURCE_, BRONZE_, SILVER_) devant chaque nom.

# Bucket source des PDF (lecture seule suffit)
SOURCE_BUCKET=factures
SOURCE_AWS_ACCESS_KEY_ID=
SOURCE_AWS_SECRET_ACCESS_KEY=
SOURCE_AWS_ENDPOINT_URL=https://dams-5.s3-gateway.console.hyperfluid.cloud
SOURCE_AWS_DEFAULT_REGION=

# Couche bronze (lecture + écriture) — étape 3
BRONZE_BUCKET=default-bronze
BRONZE_AWS_ACCESS_KEY_ID=
BRONZE_AWS_SECRET_ACCESS_KEY=
BRONZE_AWS_ENDPOINT_URL=https://dams-5.s3-gateway.console.hyperfluid.cloud
BRONZE_AWS_DEFAULT_REGION=

# Couche silver (lecture + écriture) — étape 4
SILVER_BUCKET=default-silver
SILVER_AWS_ACCESS_KEY_ID=
SILVER_AWS_SECRET_ACCESS_KEY=
SILVER_AWS_ENDPOINT_URL=https://dams-5.s3-gateway.console.hyperfluid.cloud
SILVER_AWS_DEFAULT_REGION=

# --- OCR LightOnOCR-3 (clé créée dans la console Hyperfluid) ---
# URL "Gateway URL" de la page du modèle, SANS /chat/completions à la fin (doit finir par /v1)
OCR_ENDPOINT=
OCR_API_KEY=
OCR_MODEL=

# --- LLM de l'agent (étape 8) ---
# N'importe quel service compatible API OpenAI. Exemples :
#   Ollama local (sous WSL, Ollama tourne sous Windows : adresse de l'hôte, cf. `ip route`)
#     LLM_BASE_URL=http://172.19.224.1:11434/v1   LLM_API_KEY=   LLM_MODEL=llama3.2:3b
#   Modèle hébergé : URL /v1 du fournisseur, sa clé d'API et le nom du modèle
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
